{
  "name": "broken-scripts-demo",
  "version": "1.0.0",
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "clean": "rm -rf dist coverage",
    "copy": "mkdir -p dist/assets && cp -r assets/* dist/assets",
    "lint": "eslint 'src/**/*.js'",
    "test": "jest || true",
    "start": "./scripts/start.sh",
    "deploy": "echo $DEPLOY_TARGET; node deploy.js > /dev/null 2>&1",
    "dev": "tsc -w & node server.js",
    "win": "del /q dist && .\\tools\\build.bat",
    "open": "open http://localhost:3000",
    "version-tag": "git tag v$(node -p \"require('./package.json').version\")",
    "setup": "cross-env FOO=1 node setup.js"
  }
}
